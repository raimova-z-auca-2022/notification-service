# Example environment variables (DO NOT commit real secrets)
# Copy this file to .env and fill values locally before running docker compose

# RabbitMQ credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SMS provider (optional) - leave empty for manual testing
SMS_API_TOKEN=
SMS_FROM_NUMBER=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=

# SMTP for email worker (optional)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Database overrides (optional)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
